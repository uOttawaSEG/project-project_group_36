<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="25dp"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <TextView
        android:text="Rate this Tutor"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:id="@+id/starRow"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ImageView android:id="@+id/star1" android:src="@drawable/star_empty"
            android:layout_width="35dp" android:layout_height="35dp" android:padding="5dp"/>

        <ImageView android:id="@+id/star2" android:src="@drawable/star_empty"
            android:layout_width="35dp" android:layout_height="35dp" android:padding="5dp"/>

        <ImageView android:id="@+id/star3" android:src="@drawable/star_empty"
            android:layout_width="35dp" android:layout_height="35dp" android:padding="5dp"/>

        <ImageView android:id="@+id/star4" android:src="@drawable/star_empty"
            android:layout_width="35dp" android:layout_height="35dp" android:padding="5dp"/>

        <ImageView android:id="@+id/star5" android:src="@drawable/star_empty"
            android:layout_width="35dp" android:layout_height="35dp" android:padding="5dp"/>

    </LinearLayout>

</LinearLayout>
